# ============================================================
# .gitignore for LAMMF-on-NSCLC
# Goal: `git add .` commits ONLY code (*.py) and docs (*.md).
# Everything below is data, generated output, or junk -> never committed.
# ============================================================

# ---- Raw imaging data (huge; download from TCIA per machine) ----
ct/
masks/
nsclc_radiogenomics/
NSCLC_Radiogenomics*/
*.nii
*.nii.gz
*.dcm

# ---- Generated by the pipeline (regenerable; don't commit) ----
dataset/            # data_utils cache
best/               # trained model weights
logs/               # training logs
normalized_data_csv/
train_data_csv/
csv_data/
Text_data/
data/               # synthetic-data folder, if present

# ---- Data / derived tables (all CSVs in this project are data) ----
# If you ever DO want to commit a specific csv, use: git add -f name.csv
*.csv

# ---- Model weights / scalers ----
*.pth
*.pt
*.joblib
*.pkl

# ---- Scratch / test folders we created ----
test_one/
convtest/
cnn_test/

# ---- Python junk ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# ---- Environments ----
.venv/
venv/
env/

# ---- OS / editor junk ----
.DS_Store          # macOS
Thumbs.db          # Windows
.vscode/
.idea/

dataset/
logs/
.DS_Store
